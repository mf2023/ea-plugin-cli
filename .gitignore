desktop/release
# Deliberately NOT ignored — tracked source / vendored resources:
#   desktop/renderer/assets/     (SVG/ICO image resources, incl. platforms/, search-engines/)
#   desktop/renderer/fonts/      (webfonts)
#   desktop/renderer/monaco/     (vendored Monaco editor)
#   desktop/renderer/vendor/     (vendored lucide, etc.)
#   desktop/renderer/codicon.*   (vendored icon font)
#   desktop/renderer/xterm.css   (vendored terminal styles)
#   desktop/renderer/devicon.css
#   desktop/renderer/_components.css
#   desktop/renderer/design-system.css  (single source of truth for design tokens)
# Ignoring these silently drops any NEW image/font/CSS file from `git add .`.
# Electron main-process build output (compiled from main.ts)
desktop/main.js

